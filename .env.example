APP_NAME=\ Sovereign Control Plane\
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sovereign_control_plane
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache Configuration
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mail Configuration (Optional)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=\hello@example.com\
MAIL_FROM_NAME=\\

# ========================================
# Blockchain Configuration (REQUIRED)
# ========================================
CONTRACT_ADDRESS=0xYourDeployedContract
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/413f33b633904508ad826bd9b0e13ec6
SEPOLIA_PRIVATE_KEY=YTKJjD1r0DgyziqkBKWc1ek1Ew2EkLyRXL7OBvWJ1X5Qu5sBLWihmg
ETHERSCAN_API_KEY=your_etherscan_api_key

# ========================================
# OAuth Configuration (Optional)
# ========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# ========================================
# Rate Limiting Configuration
# ========================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ========================================
# Queue Configuration
# ========================================
QUEUE_MAX_TRIES=3
QUEUE_BACKOFF=60
